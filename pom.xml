<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright The A2A Spring Authors
  SPDX-License-Identifier: Apache-2.0

  Migrated from org.wildfly.a2a:a2a-jakarta-parent (Jakarta EE / WildFly).

  Jakarta -> Spring build mapping:
    org.jboss:jboss-parent:53              -> org.springframework.boot:spring-boot-starter-parent
    wildfly-standard-ee-bom                -> spring-boot-dependencies (via parent)
    arquillian-bom / wildfly-arquillian-bom-> spring-boot-starter-test (@SpringBootTest)
    shrinkwrap-bom                         -> (dropped; no archive assembly needed)
    wildfly-maven-plugin / galleon          -> spring-boot-maven-plugin
    wildfly-glow-arquillian-plugin          -> (dropped)
  The A2A SDK BOM is retained unchanged - the SDK itself is framework neutral.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>org.a2a.spring</groupId>
    <artifactId>a2a-spring-parent</artifactId>
    <version>1.0.0.Final-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>A2A Spring Parent</name>
    <description>Spring Boot integration layer for the A2A Java SDK (migrated from the Jakarta EE / WildFly layer).</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- A2A SDK: unchanged from the Jakarta build. -->
        <version.jakarta.cdi>4.0.1</version.jakarta.cdi>
        <version.jakarta.inject>2.0.1</version.jakarta.inject>
        <version.sdk>1.2.0.Final</version.sdk>

        <!-- gRPC server integration replacing the WildFly gRPC subsystem/feature-pack. -->
        <version.grpc.spring>3.1.0.RELEASE</version.grpc.spring>

        <!-- Test tooling. junit/mockito/hamcrest versions are managed by spring-boot-dependencies. -->
        <version.rest-assured>5.5.5</version.rest-assured>
        <version.exec.plugin>3.5.0</version.exec.plugin>
    </properties>

    <repositories>
        <repository>
            <id>jboss-public-repository-group</id>
            <name>JBoss Public Repository Group</name>
            <url>https://repository.jboss.org/nexus/content/groups/public/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <modules>
        <module>http-common</module>
        <module>impl/jsonrpc</module>
        <module>impl/rest</module>
        <module>impl/grpc</module>
        <module>compat-0.3</module>
        <module>examples</module>
        <module>tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- A2A SDK BOM - framework neutral, carried over verbatim. -->
            <dependency>
                <groupId>org.a2aproject.sdk</groupId>
                <artifactId>a2a-java-sdk-bom</artifactId>
                <version>${version.sdk}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- gRPC server starter replacing the WildFly gRPC feature-pack. -->
            <dependency>
                <groupId>net.devh</groupId>
                <artifactId>grpc-server-spring-boot-starter</artifactId>
                <version>${version.grpc.spring}</version>
            </dependency>

            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured</artifactId>
                <version>${version.rest-assured}</version>
                <scope>test</scope>
            </dependency>

            <!-- Internal modules. -->
            <dependency>
                <groupId>org.a2a.spring</groupId>
                <artifactId>a2a-spring-http-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2a.spring</groupId>
                <artifactId>a2a-spring-jsonrpc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2a.spring</groupId>
                <artifactId>a2a-spring-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2a.spring</groupId>
                <artifactId>a2a-spring-grpc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2a.spring</groupId>
                <artifactId>a2a-spring-compat-0.3-jsonrpc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2a.spring</groupId>
                <artifactId>a2a-spring-compat-0.3-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.a2a.spring</groupId>
                <artifactId>a2a-spring-compat-0.3-grpc</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${version.exec.plugin}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--
                JaCoCo replaces nothing from the Jakarta original, which shipped no coverage
                tooling. It is added so the migration can report measured line/branch coverage
                for the migrated code rather than asserting coverage without evidence.
                The version is managed by spring-boot-starter-parent.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
