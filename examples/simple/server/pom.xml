<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Migrated from: examples/simple/server/pom.xml (org.wildfly.a2a:a2a-jakarta-example-simple-server)

      PACKAGING
        war  ->  jar. The Jakarta build produced a ROOT.war that the wildfly-maven-plugin
        deployed into a provisioned WildFly server at context path "/". The Spring build
        produces an executable jar with an embedded Tomcat, which serves at "/" by default
        (server.servlet.context-path defaults to "/"), so the externally visible URLs are
        unchanged: http://localhost:8080/

      BUILD PLUGINS
        org.wildfly.plugins:wildfly-maven-plugin  ->  spring-boot-maven-plugin (repackage)
        The entire galleon provisioning block is DROPPED:
          - <feature-pack> org.wildfly:wildfly-galleon-pack        (no app server to provision)
          - <feature-pack> org.wildfly.grpc:wildfly-grpc-feature-pack (replaced by grpc-server-spring-boot-starter)
          - <discover-provisioning-info/> + <add-on>grpc</add-on>  (no subsystem discovery)
          - <galleon-option>jboss-fork-embedded</galleon-option>   (no embedded host controller)
          - <stability-level>preview</stability-level>             (no WildFly stability levels)
          - <name>ROOT.war</name> / <jboss-home>/<provisioning-dir>

      DEPENDENCIES
        jakarta.enterprise:jakarta.enterprise.cdi-api (provided)  ->  spring-boot-starter (spring-context)
        jakarta.ws.rs:jakarta.ws.rs-api (provided)                ->  spring-boot-starter-web
        The CDI/inject exclusions on a2a-java-sdk-server-common are retained for the same
        reason as in the transport modules: the SDK's optional CDI API must not land on a
        Spring classpath where nothing implements it.

      PROFILES
        The source declared three profiles (jsonrpc / grpc / rest), each of which both
        selected a transport dependency AND switched wildfly.maven.plugin.phase from "none"
        to "package" so the server was only provisioned on demand. Only the dependency half
        survives; the provisioning half has no counterpart. "jsonrpc" is now
        activeByDefault so that `mvn spring-boot:run` works with no flags - under Jakarta
        the no-profile build deliberately produced a war with no server to deploy it to,
        which is not a meaningful default for a self-contained executable jar.
    -->

    <parent>
        <groupId>org.a2a.spring</groupId>
        <artifactId>a2a-spring-examples-parent</artifactId>
        <version>1.0.0.Final-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>a2a-spring-example-simple-server</artifactId>
    <packaging>jar</packaging>
    <name>A2A Spring :: Examples :: Simple :: Server</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-server-common</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>jakarta.enterprise.cdi-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.inject</groupId>
                    <artifactId>jakarta.inject-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.a2a.spring.examples.simple.SimpleExampleApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jsonrpc</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.a2a.spring</groupId>
                    <artifactId>a2a-spring-jsonrpc</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>rest</id>
            <dependencies>
                <dependency>
                    <groupId>org.a2a.spring</groupId>
                    <artifactId>a2a-spring-rest</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <!-- REST needs JSONRPC to serve the agent card, as in the source build. -->
                <dependency>
                    <groupId>org.a2a.spring</groupId>
                    <artifactId>a2a-spring-jsonrpc</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>grpc</id>
            <dependencies>
                <!--
                  The source excluded io.grpc:* and com.google.protobuf:protobuf-java here
                  because the WildFly gRPC feature-pack supplied them as server modules.
                  Spring Boot has no such provider, so the exclusions are REMOVED and the
                  grpc-server-spring-boot-starter brings the runtime in transitively.
                -->
                <dependency>
                    <groupId>org.a2a.spring</groupId>
                    <artifactId>a2a-spring-grpc</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <!-- gRPC needs JSONRPC to get the agent card. -->
                <dependency>
                    <groupId>org.a2a.spring</groupId>
                    <artifactId>a2a-spring-jsonrpc</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
