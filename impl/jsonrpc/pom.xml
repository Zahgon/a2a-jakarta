<!--
  Migrated from a2a-jakarta/impl/jsonrpc/pom.xml (org.wildfly.a2a:a2a-jakarta-jsonrpc).

  Dependency mapping applied:
    jakarta.ws.rs:jakarta.ws.rs-api            (provided) -> spring-boot-starter-web (Spring MVC)
    jakarta.servlet:jakarta.servlet-api        (provided) -> spring-boot-starter-web (embedded Tomcat)
    jakarta.enterprise:jakarta.enterprise.cdi-api (provided) -> spring-context (transitive via starter)
    jakarta.inject:jakarta.inject-api          (provided) -> spring-context (transitive via starter)

  The SDK exclusions of cdi-api / inject-api are RETAINED: the SDK's transport
  artifacts declare them so they can be used inside a CDI container, but under
  Spring the container is the Spring ApplicationContext and those APIs must not
  leak onto the classpath (an unimplemented CDI API on the classpath causes
  confusing NoClassDefFound/ambiguity failures).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.a2a.spring</groupId>
        <artifactId>a2a-spring-parent</artifactId>
        <version>1.0.0.Final-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>a2a-spring-jsonrpc</artifactId>
    <packaging>jar</packaging>
    <name>A2A Spring :: JSON-RPC Transport</name>

    <dependencies>
        <dependency>
            <groupId>org.a2a.spring</groupId>
            <artifactId>a2a-spring-http-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-transport-jsonrpc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>jakarta.enterprise</groupId>
                    <artifactId>jakarta.enterprise.cdi-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.inject</groupId>
                    <artifactId>jakarta.inject-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.a2aproject.sdk</groupId>
            <artifactId>a2a-java-sdk-jsonrpc-common</artifactId>
            <version>${version.sdk}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
